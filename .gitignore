# Built variants and release output (Android Studio writes signed bundles to app/release/)
*.apk
*.aar
*.ap_
*.aab
release/

# Files generated by Gradle / Kotlin / Android Studio
build/
.gradle/
.kotlin/
local.properties
captures/

# Signing material: never commit keys or passwords
*.jks
*.keystore
*.p12
*.pfx
*.pem
keystore.properties

# Android Studio: user-specific settings (shared files such as misc.xml and compiler.xml stay tracked)
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/deviceManager.xml
.idea/appInsightsSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/shelf
*.iml

# Dumps and logs
*.hprof
hs_err_pid*
*.log

# OS generated files
.DS_Store
Thumbs.db
