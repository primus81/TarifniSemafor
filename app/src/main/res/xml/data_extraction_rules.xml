<?xml version="1.0" encoding="utf-8"?><!-- Android 12+: only the user's settings (theme, language, notification choices, privacy notice answer) go into the
     cloud backup and the device-to-device transfer, so a new phone starts with the same choices.
     Everything else stays on this phone: the Moj Elektro token, EIMM and readings (their Keystore key can never
     leave the device anyway), the caches and the per-device permission state (file "device_state").
     With <include>, only the listed files are backed up. Keep in sync with backup_rules.xml (Android 11 and older). -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
