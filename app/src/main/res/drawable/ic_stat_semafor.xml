<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar icon of every notification: the logo (lightning bolt outline from the Slike folder).
     Android draws status bar icons as a single colour mask (white), so only the shape matters here;
     the block colour is applied with setColor() where Android shows it (notification shade). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M58,8 L28,55 L47,55 L35,92 L75,43 L54,43 L70,8 Z" />
    </group>
</vector>
